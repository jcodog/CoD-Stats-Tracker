    "test:api": "bun test \"src/app/api/(chatgpt-app-connector)/app/__tests__/routes.test.mjs\"",
    "test:debug": "bun test \"src/app/(chatgpt-app-connector)/debug/__tests__/chatgpt-app-config.test.mjs\"",
    "test:mcp": "bun test \"src/lib/server/__tests__/chatgpt-app-mcp.test.mjs\"",
    "test:oauth": "bun test \"src/app/(chatgpt-app-connector)/oauth/__tests__\"",
    "test:features": "bun test \"src/features/dashboard-stats/lib/__tests__/dashboard-stats-log-match-flow.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
