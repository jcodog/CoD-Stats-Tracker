{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run --cwd ../.. coverage:prepare && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun run test:env && bun run test:api && bun run test:debug && bun run test:oauth && bun run test:mcp && bun run test:features",
    "test:env": "bun test \"src/lib/server/__tests__/app-public-origin.test.mjs\" \"src/lib/server/__tests__/server-env.test.mjs\"",
    "test:api": "bun test \"src/app/api/(chatgpt-app-connector)/app/__tests__/routes.test.mjs\"",
    "test:debug": "bun test \"src/app/(chatgpt-app-connector)/debug/__tests__/chatgpt-app-config.test.mjs\"",
    "test:mcp": "bun test \"src/lib/server/__tests__/chatgpt-app-mcp.test.mjs\"",
    "test:oauth": "bun test \"src/app/(chatgpt-app-connector)/oauth/__tests__\"",
    "test:features": "bun test \"src/features/dashboard-stats/lib/__tests__/dashboard-stats-log-match-flow.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.22",
    "@clerk/themes": "^2.4.57",
    "@databuddy/sdk": "^2.6.0",
    "@flags-sdk/vercel": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@workspace/backend": "workspace:*",
    "@workspace/ui": "workspace:*",
    "convex": "^1.42.3",
    "flags": "^4.2.1",
    "next": "16.3.0-preview.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.7.0",
    "typescript": "^7.0.2"
  }
}
